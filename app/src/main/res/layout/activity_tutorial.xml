<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_surface"
    tools:context=".TutorialActivity">

    <TextView
        android:id="@+id/text_tutorial_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:accessibilityHeading="true"
        android:text="@string/tutorial_title"
        android:textAlignment="center"
        android:textAppearance="@style/TextAppearance.AppCompat.Large"
        android:textColor="@color/brand_text_primary"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:layout_editor_absoluteY="88dp" />

    <ScrollView
        android:id="@+id/scroll_tutorial"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toTopOf="@id/button_tutorial_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text_tutorial_title">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_tutorial_intro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tutorial_intro"
                android:textColor="@color/brand_text_primary"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/text_tutorial_use_case_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:accessibilityHeading="true"
                android:text="@string/tutorial_use_case_title"
                android:textColor="@color/brand_text_primary"
                android:textStyle="bold"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/text_tutorial_use_case_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/tutorial_use_case_body"
                android:textColor="@color/brand_text_secondary"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/text_tutorial_table_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:accessibilityHeading="true"
                android:text="@string/tutorial_table_title"
                android:textColor="@color/brand_text_primary"
                android:textStyle="bold"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/text_tutorial_table_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/tutorial_table_body"
                android:textColor="@color/brand_text_secondary"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/text_tutorial_resources_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:accessibilityHeading="true"
                android:text="@string/tutorial_resources_title"
                android:textColor="@color/brand_text_primary"
                android:textStyle="bold"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/text_tutorial_resources_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/tutorial_resources_body"
                android:textColor="@color/brand_text_secondary"
                android:textSize="18sp" />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/button_tutorial_back"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:backgroundTint="@color/brand_green"
        android:contentDescription="@string/tutorial_back_button"
        android:text="@string/tutorial_back_button"
        android:textColor="@color/white"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
