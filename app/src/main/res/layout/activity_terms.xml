<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_surface"
    tools:context=".TermsActivity">

    <TextView
        android:id="@+id/text_terms_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:accessibilityHeading="true"
        android:text="@string/terms_title"
        android:textAlignment="center"
        android:textAppearance="@style/TextAppearance.AppCompat.Large"
        android:textColor="@color/brand_text_primary"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:layout_editor_absoluteY="88dp" />

    <ScrollView
        android:id="@+id/scroll_terms"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toTopOf="@id/button_terms_service"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text_terms_title">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_terms_intro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/brand_text_primary"
                android:textSize="18sp"
                tools:text="Para usar o Arpiagrama, você concorda com o seguinte:" />

            <TextView
                android:id="@+id/text_terms_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/brand_text_secondary"
                android:textSize="18sp"
                tools:text="• O Arpiagrama pode conectar-se ao seu dispositivo..." />

            <TextView
                android:id="@+id/text_terms_footer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/brand_text_secondary"
                android:textSize="18sp"
                tools:text="Ao clicar em Eu concordo" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_terms_service"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:contentDescription="@string/terms_service"
        android:text="@string/terms_service"
        android:textColor="@color/brand_green"
        android:textSize="18sp"
        app:strokeColor="@color/brand_green"
        app:strokeWidth="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/scroll_terms" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_privacy_policy"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="24dp"
        android:contentDescription="@string/terms_privacy"
        android:text="@string/terms_privacy"
        android:textColor="@color/brand_green"
        android:textSize="18sp"
        app:strokeColor="@color/brand_green"
        app:strokeWidth="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/button_terms_service" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_accept"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="24dp"
        android:contentDescription="@string/terms_accept"
        android:text="@string/terms_accept"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:backgroundTint="@color/brand_green"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/button_privacy_policy" />

</androidx.constraintlayout.widget.ConstraintLayout>
